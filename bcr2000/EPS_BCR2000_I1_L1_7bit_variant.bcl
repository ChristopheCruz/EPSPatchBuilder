; Ensoniq EPS (classic) - BCR2000 preset, SysEx PUT PARAMETER - 7bit value format
; Target: instrument 1, layer 1, all wavesamples. EPS base channel = 1.
; No $store: the preset lands in the BCR2000 edit buffer.
$rev R1
$preset
  .name 'EPS I1 L1 ALL           '
  .snapshot off
  .request off
  .egroups 4
  .fkeys on
  .lock off
  .init
$encoder 1 ; Fine Tune (4,10) 0-127 [positive half only]
  .showvalue on
  .mode bar
  .resolution 96 96 96 96
  .default 0
  .minmax 0 127
  .tx $F0 $0F $03 $00 $11 $00 $00 $00 $00 $00 $00 $10 $0A $00 $00 $00 val $F7
$encoder 2 ; Pitch LFO Amount (4,2) 0-127
  .showvalue on
  .mode bar
  .resolution 96 96 96 96
  .default 0
  .minmax 0 127
